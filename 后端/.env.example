# ===========================================
# WildAPI - AI API 中转站 环境变量配置
# 复制此文件为 .env 并填入实际值
# ===========================================

# 服务端口
PORT=3000

# MySQL 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<REQUIRED: MySQL 密码>
DB_NAME=wildapi
DB_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 本地会话
JWT_SECRET=<REQUIRED: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
JWT_EXPIRES_IN=24h

# AES-256-GCM 加密密钥 (64位十六进制字符)
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<REQUIRED: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# WildAccount SSO 认证中心
SSO_CLIENT_ID=wildapi
SSO_CLIENT_SECRET=<REQUIRED: 在 WildAccount 认证中心申请>
# 认证中心地址: 本地开发 http://localhost:4000，同机 Docker 部署 http://host.docker.internal:4000
SSO_AUTH_URL=http://localhost:4000

# 邮件服务 (飞书企业邮箱 SMTP)
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wildapi@wildcreator.top
SMTP_PASS=<REQUIRED: SMTP 授权码>
ADMIN_EMAIL=admin@wildcreator.top

# 前端地址 (CORS 白名单)
FRONTEND_URL=http://localhost:5173

# 全局速率限制 (每个 IP 每分钟最大请求数)
GLOBAL_RATE_LIMIT=600

# 运行环境: 留空或 production 时 JWT_SECRET/ENCRYPTION_KEY 用占位符会拒绝启动。
# 仅显式 development / test 才允许使用内置开发密钥
# NODE_ENV=production

# 反向代理信任: 服务在 nginx 之后时必须信任 X-Forwarded-For，
# 否则全局限流会把所有客户端当成同一个 IP。1 = 信任一跳 (默认)，
# 可填跳数、'loopback'、CIDR 列表；直连暴露后端时填 false
# TRUST_PROXY=1

# 日志级别 (error / warn / info / debug)，默认 info
# LOG_LEVEL=info

# 生产环境文件日志目录 (默认取当前工作目录下的 logs/，不存在会自动创建)
# LOG_DIR=/var/log/wildapi

# 上游密钥可用性检测间隔 (分钟)，默认 10
# AVAILABILITY_CHECK_INTERVAL_MIN=10
