# ===========================================
# WildAPI - Docker 部署环境变量示例
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# 注意: 所有 <REQUIRED:> 占位符必须替换，deploy.sh 会校验
# ===========================================

# ---- 部署标识 (单实例标准配置，无需修改) ----
PREFIX=wildapi
DATA_DIR=/opt/WildAPI

# ---- MySQL 数据库 ----
MYSQL_ROOT_PASSWORD=<REQUIRED: MySQL root 密码>
MYSQL_DATABASE=wildapi
# 迁移脚本硬编码库名 wildapi (CREATE DATABASE / USE / information_schema 判断)，
# 改这里会让表建到 wildapi 而应用连自己那个空库，启动日志会报"当前库中没有 users 表"
MYSQL_USER=wildapi
MYSQL_PASSWORD=<REQUIRED: MySQL 业务账号密码>
# 宿主机 3306 被占用时改用其他端口 (仅绑定 127.0.0.1)
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=<REQUIRED: Redis 密码>
# 宿主机 6379 被占用时改用其他端口 (仅绑定 127.0.0.1)
REDIS_PORT=6379

# ---- JWT 本地会话 ----
JWT_SECRET=<REQUIRED: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
JWT_EXPIRES_IN=24h

# ---- AES-256-GCM 加密密钥 (64 位十六进制) ----
# 供应商密钥/用户 API Key 以此密钥加密存储，生成后不可更换 (否则已存密钥无法解密)
ENCRYPTION_KEY=<REQUIRED: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ---- WildAccount SSO 认证中心 ----
SSO_CLIENT_ID=wildapi
SSO_CLIENT_SECRET=<REQUIRED: 在 WildAccount 认证中心申请>
# 后端直连同机认证中心 (宿主机 4000 端口)
SSO_AUTH_URL=http://host.docker.internal:4000

# ---- 邮件通知 (SMTP) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=<REQUIRED: SMTP 授权码>
ADMIN_EMAIL=

# ---- 前端 ----
# 80 端口被宝塔/Nginx 占用时改用其他端口 (如 3002)
FRONTEND_PORT=80
VITE_API_URL=/api
VITE_SSO_AUTH_URL=https://login.wildcreator.top
VITE_SSO_CLIENT_ID=wildapi

# ---- 后端端口 ----
# 3000 端口被占用时改用其他端口 (如 3001，仅绑定 127.0.0.1)
BACKEND_PORT=3000

# ---- 前端生产地址 (CORS 白名单) ----
FRONTEND_URL=http://localhost

# ---- 全局速率限制 ----
GLOBAL_RATE_LIMIT=600
