# ============================================
# WildAPI - 前端 Docker 镜像 (多阶段构建)
# React 应用构建 + Nginx 静态服务
# ============================================

# ---- 阶段 1: 构建 React 应用 ----
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci && npm cache clean --force

COPY . ./

# 构建时环境变量 (可被 docker build --build-arg 覆盖)
ARG VITE_API_URL=/api
ARG VITE_SSO_AUTH_URL=https://login.wildcreator.top
ARG VITE_SSO_CLIENT_ID=wildapi
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SSO_AUTH_URL=$VITE_SSO_AUTH_URL
ENV VITE_SSO_CLIENT_ID=$VITE_SSO_CLIENT_ID

RUN npm run build

# ---- 阶段 2: Nginx 生产服务 ----
FROM nginx:alpine

RUN apk add --no-cache tzdata curl && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# 复制 Nginx 配置和构建产物
# 注意: nginx.conf 由 deploy.sh 从 后端/docker/nginx.conf 自动同步到前端目录
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
